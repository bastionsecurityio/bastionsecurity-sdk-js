{
  "name": "@bastionsecurity/sdk",
  "version": "0.2.0",
  "description": "Bastion Security client-side SDK for bot detection and device fingerprinting",
  "main": "dist/bastion.js",
  "module": "dist/bastion.esm.mjs",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rollup -c",
    "dev": "rollup -c -w",
    "typecheck": "tsc --noEmit",
    "prepare": "npm run build",
    "test": "npm run build && node --test test/*.test.cjs"
  },
  "devDependencies": {
    "@rollup/plugin-typescript": "^11.1.6",
    "@types/node": "^20.19.43",
    "rollup": "^4.22.0",
    "tslib": "^2.7.0",
    "typescript": "^5.6.0"
  },
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/bastion.esm.mjs",
      "require": "./dist/bastion.js"
    }
  }
}
